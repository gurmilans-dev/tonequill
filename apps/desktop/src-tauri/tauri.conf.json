{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonequill",
  "version": "0.1.0",
  "identifier": "local.tonequill.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Tonequill", "width": 1160, "height": 820, "minWidth": 760, "minHeight": 620, "backgroundColor": "#f5f6f3" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'" }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "category": "Utility",
    "shortDescription": "Send files through sound",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
